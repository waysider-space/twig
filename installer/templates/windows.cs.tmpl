using System;
using System.IO;
using System.Runtime.InteropServices;
using System.Text;
using Microsoft.Win32.SafeHandles;

public static class TwigNative {
  [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
  private static extern SafeFileHandle CreateFile(string name, uint access, uint sharing, IntPtr security, uint disposition, uint flags, IntPtr template);

  [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
  private static extern uint GetFinalPathNameByHandle(SafeFileHandle handle, StringBuilder path, uint size, uint flags);

  public static string Root(string path) {
    using (SafeFileHandle handle = CreateFile(path, 0, 7, IntPtr.Zero, 3, 0x02000000, IntPtr.Zero)) {
      if (handle.IsInvalid) { throw new IOException("Cannot resolve installation root"); }
      StringBuilder result = new StringBuilder(32768);
      uint length = GetFinalPathNameByHandle(handle, result, (uint)result.Capacity, 0);
      if (length == 0 || length >= result.Capacity) { throw new IOException("Cannot resolve installation root"); }
      string value = result.ToString();
      if (value.StartsWith(@"\\?\UNC\", StringComparison.OrdinalIgnoreCase)) { return @"\\" + value.Substring(8); }
      if (value.StartsWith(@"\\?\", StringComparison.Ordinal)) { return value.Substring(4); }

      return value;
    }
  }

  public static uint[] Checksums(string path, long maxEntries) {
    using (BinaryReader reader = new BinaryReader(File.OpenRead(path))) {
      Stream stream = reader.BaseStream;
      long end = -1;
      for (long offset = stream.Length - 22; offset >= Math.Max(0, stream.Length - 65557); offset--) {
        stream.Position = offset;
        if (reader.ReadUInt32() == 0x06054b50) {
          stream.Position = offset + 20;
          if (offset + 22 + reader.ReadUInt16() == stream.Length) { end = offset; break; }
        }
      }
      if (end < 0) { throw new IOException("Invalid ZIP directory"); }
      stream.Position = end + 4;
      if (reader.ReadUInt16() != 0 || reader.ReadUInt16() != 0) { throw new IOException("Split ZIP archives are unsupported"); }
      ushort diskCount = reader.ReadUInt16();
      ulong count = reader.ReadUInt16();
      uint size = reader.ReadUInt32();
      ulong directory = reader.ReadUInt32();
      if (diskCount == ushort.MaxValue || count == ushort.MaxValue || directory == uint.MaxValue || size == uint.MaxValue) {
        if (end < 20) { throw new IOException("Invalid ZIP64 directory"); }
        stream.Position = end - 20;
        if (reader.ReadUInt32() != 0x07064b50 || reader.ReadUInt32() != 0) { throw new IOException("Invalid ZIP64 locator"); }
        ulong record = reader.ReadUInt64();
        if (reader.ReadUInt32() != 1 || record > (ulong)(end - 56)) { throw new IOException("Invalid ZIP64 locator"); }
        stream.Position = (long)record;
        if (reader.ReadUInt32() != 0x06064b50) { throw new IOException("Invalid ZIP64 record"); }
        stream.Position = (long)record + 16;
        if (reader.ReadUInt32() != 0 || reader.ReadUInt32() != 0) { throw new IOException("Split ZIP archives are unsupported"); }
        ulong diskEntries = reader.ReadUInt64();
        count = reader.ReadUInt64();
        if (diskEntries != count) { throw new IOException("Invalid ZIP64 entry count"); }
        reader.ReadUInt64();
        directory = reader.ReadUInt64();
      } else if (diskCount != count) {
        throw new IOException("Invalid ZIP entry count");
      }
      if (count > int.MaxValue || (maxEntries > 0 && count > (ulong)maxEntries) || directory > (ulong)end) { throw new IOException("Invalid ZIP directory limits"); }
      stream.Position = (long)directory;
      uint[] checksums = new uint[(int)count];
      for (int index = 0; index < checksums.Length; index++) {
        long start = stream.Position;
        if (reader.ReadUInt32() != 0x02014b50) { throw new IOException("Invalid ZIP entry"); }
        stream.Position = start + 16;
        checksums[index] = reader.ReadUInt32();
        stream.Position = start + 28;
        int name = reader.ReadUInt16();
        int extra = reader.ReadUInt16();
        int comment = reader.ReadUInt16();
        if (reader.ReadUInt16() != 0) { throw new IOException("Split ZIP archives are unsupported"); }
        long next = start + 46 + name + extra + comment;
        if (next > end) { throw new IOException("Invalid ZIP entry length"); }
        stream.Position = next;
      }

      return checksums;
    }
  }

  public static uint Stage(Stream source, Stream destination, long expected, long limit) {
    uint[] table = new uint[256];
    for (uint index = 0; index < 256; index++) {
      uint value = index;
      for (int bit = 0; bit < 8; bit++) { value = (value >> 1) ^ ((value & 1) == 0 ? 0u : 0xedb88320u); }
      table[index] = value;
    }
    byte[] buffer = new byte[65536];
    long written = 0;
    uint crc = uint.MaxValue;
    int read;
    while ((read = source.Read(buffer, 0, buffer.Length)) > 0) {
      if ((limit > 0 && read > limit - written) || read > expected - written) { throw new IOException("Archive exceeds expanded size limit"); }
      for (int index = 0; index < read; index++) { crc = table[(crc ^ buffer[index]) & 255] ^ (crc >> 8); }
      destination.Write(buffer, 0, read);
      written += read;
    }
    if (written != expected) { throw new IOException("Invalid archive file length"); }

    return crc ^ uint.MaxValue;
  }
}
